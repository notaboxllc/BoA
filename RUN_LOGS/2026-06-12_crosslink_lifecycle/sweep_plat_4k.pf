nodeTetherDetachRate:false:0.0010;      // Node Tether Detachment Rate
forminMoves:false:0.0;                  // Mobile Attachment Point of formin to node
forminRelease:true:1.0;                 // Random formin release rate
noMonomers:true:0.0;                    // No monomers simulated or rendered (static geometry)
filamentsAnneal:false:0.0;              // Do filaments end-to-end anneal?
annealDist:true:0.054;                  // Tip distance for annealing
annealAngleCosine:true:0.9;             // Cosine of max. angle for annealing
maxLinksOnSeg:true:10.0;                // Max. Cross-Links per Segment
sideBonds:true:0.0;                     // Side bonds? (=Env.xLinks: 0 = both parallel & antiparallel) ACTIVE
maxXLinkBondAngle:true:0.6;             // ~34deg — widened from pi/12 (15deg) for robust link formation
sideBondsRelax:false:0.0;               // Do side bonds relax, allowing translation of bound fils?
