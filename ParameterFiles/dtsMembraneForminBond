<BOA> DTS membrane v2 -- FORMIN-MEMBRANE BOND focus: a FEW formin mothers, each held by its BARBED end at the
<BOA> cortex, with NO formin release (forminRelease=0) and NO Arp branching. Brownian damped 20x on the held
<BOA> mothers (forminBarbedBrownianFactor). Purpose: study the membrane-filament bond in isolation -- no flying
<BOA> debris from released mothers or shed branches.

buildDtsMembrane:true:1.0;
dtsMembraneSubdiv:true:4;
dtsMembraneRadius:true:1.2;
dtsVertexRadiusFrac:true:0.5;

dtsKappaBend:true:1.0e-19;
dtsKappaArea:true:0.15;
dtsKappaVolume:true:1.0e-13;
dtsTargetReducedVol:true:1.0;
dtsMaxDispFrac:true:0.2;
dtsBrownianOff:true:1.0;
dtsAnchorStiffness:true:0.015;

// --- Arp field: ONE small hot patch -> only a few hot vertices -> a few formin mothers ---
dtsArpOn:true:1.0;
dtsArpHotPatches:true:1;
dtsArpHotPatchDeg:true:6.0;
dtsArpDiffusion:true:0.1;
dtsArpDecay:true:0.015;

// --- formin mothers, barbed end held at the cortex; NO RELEASE ---
dtsForminOn:true:1.0;
dtsForminGrowOut:true:1.0;
dtsForminPool:true:1.0;            // 1 mother per hot vertex
dtsForminConsume:true:1.0;
dtsForminNucRate:true:200.0;      // high rate, but pool=1/vertex caps it at ~6 mothers (one per hot vertex)
dtsForminRecover:true:0.0;
forminRelease:true:0.0;            // <-- RELEASE TERM OFF: mothers stay bonded to the membrane
forminBarbedBrownianFactor:true:0.05;   // 20x-down thermal on the held mothers
dtsForminStandoff:true:0.05;       // <-- formin holds the barbed end this far (um) OFF the membrane:
                                   //     tether rest-position agrees with the steric collision -> no battle,
                                   //     membrane stays smooth (rStd 0.0006 vs 0.012 at-surface)
actinSeed:true:8;

// --- NO Arp2/3 branching: no daughter filaments ---
dtsBranchOn:false:0.0;
dtsMaxFilaments:true:2000;

// --- actin-membrane collision (the bond + steric) + slow growth so the held bond is visible ---
dtsActinCollide:true:1.0;
dtsRatchetForce:true:0.0;
ratchetOn:true:1.0;
ratchetForce:true:1.5e-12;
actinConc:true:5.0;                // modest free-G-actin pool: slow barbed-end elongation, little shedding
filTipRadiusForCollision:true:0.04;

deltaT:true:1.0E-5;
collisionDeltaT:true:1.0E-5;
brownianDeltaT:true:1.0E-5;
biochemDeltaT:true:0.001;
runTime:true:0.08;
toFileInterval:true:120.0;
remoteWriteInterval:true:2000.0;

boxXDim:true:5.0;
boxYDim:true:5.0;
boxZDim:true:5.0;
aeta:true:0.1;

simOutsideBug:false:0.0;
initialFilaments:false:0.0;
initialMyoMiniFils:false:0.0;
equilNodes:false:0.0;
fillNodeCt:true:0;
buildBranchedFils:false:0.0;
buildMembraneSheet:false:0.0;
buildMembraneSphere:false:0.0;
forminConc:true:0.0;
arpConc:true:0.0;
