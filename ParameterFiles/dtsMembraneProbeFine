<BOA> DTS membrane v2 -- PROBE DEMO: a single node, driven outward (+x) with a CONSTANT force, pushes a
<BOA> bulge into the bilayer and STALLS when the membrane's bending + area + volume reaction balances the
<BOA> drive. No actin -- this isolates the membrane's mechanical character (a clean stand-in for the
<BOA> Stage-3 actin steric push). Watch the [DTS-PROBE] readout: x advances, then stalls as reaction -> drive.

buildDtsMembrane:true:1.0;
dtsMembraneSubdiv:true:5;          // nu=4 -> 2562 vertices (smooth bulge)
dtsMembraneRadius:true:1.2;
dtsVertexRadiusFrac:true:0.5;

// --- membrane mechanics (moderately compliant so the bulge is visible, then stalls) ---
dtsKappaBend:true:1.0e-19;
dtsKappaArea:true:0.1;             // allows some areal stretch into the bulge
dtsKappaVolume:true:2.0e-14;       // some volume give (bulge borrows volume; rest dimples in)
dtsTargetReducedVol:true:1.0;
dtsMaxDispFrac:true:0.15;          // displacement clamp (stability)

// --- the constant-force probe ---
dtsProbeForce:true:1.2e-10;
dtsProbeRadius:true:0.12;
dtsProbeStartX:true:0.9;

deltaT:true:1.0E-5;
collisionDeltaT:true:1.0E-5;
brownianDeltaT:true:1.0E-5;
biochemDeltaT:true:0.001;
runTime:true:0.2;
toFileInterval:true:150.0;
remoteWriteInterval:true:2000.0;
dtsBrownianOff:true:1.0;

boxXDim:true:5.0;
boxYDim:true:5.0;
boxZDim:true:5.0;
aeta:true:0.1;

// --- actin / motors / bugs / legacy membrane OFF ---
simOutsideBug:false:0.0;
initialFilaments:false:0.0;
initialMyoMiniFils:false:0.0;
equilNodes:false:0.0;
fillNodeCt:true:0;
buildBranchedFils:false:0.0;
buildMembraneSheet:false:0.0;
buildMembraneSphere:false:0.0;
forminConc:true:0.0;
ratchetOn:false:0.0;
