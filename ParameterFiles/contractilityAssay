<BOA> Minimal contractility assay — two anti-parallel stiff filaments pinned at their PLUS ends to
// the outer box walls, one bipolar minifilament in the central overlap. Measures the isometric
// contractile tension at each anchor (the [STATS] contractility lines: tensionA/tensionB, pN,
// contractile = positive). RUN ON CPU (omit -gpu). The assay IC + pin + readout are CPU-only.
//   java -Xmx800M -cp ".:libs/*" BoxOfActin -r -pf ParameterFiles/contractilityAssay -3js <dir>
deltaT:true:1.0E-5;                     // small, stable
biochemDeltaT:true:0.01;
collisionDeltaT:true:1.0E-5;
brownianDeltaT:true:1.0E-5;
runTime:true:0.5;                       // 50k steps @ 1e-5
toFileInterval:true:500.0;              // ~100 frames / [STATS] samples
remoteWriteInterval:true:5000.0;
// --- phalloidin-stiff bending regime (filaments stay straight, don't buckle) ---
fracMove:true:0.0573;
fracR:true:1.0;
fracMoveTorq:true:0.01;
aeta:true:0.1;                          // viscosity (Pa·s)
// --- box: long in X (filament axis), thin in Y/Z (confines the minifilament laterally) ---
boxXDim:true:4.0;
boxYDim:true:0.3;
boxZDim:true:0.2;
// --- the assay ---
contractilityAssay:true:1.0;
contractFilNSegs:true:13.0;             // 13 × (64+1)·0.0027 µm ≈ 2.28 µm contour per filament
contractFilYOffset:true:0.05;           // filaments at y=±0.05 µm; minifilament axis at y=0
contractNoMotor:false:0.0;              // set true for the no-motor control
contractReversePolarity:false:0.0;      // set true for the reversed-polarity (extension) control
filSegLength:true:64.0;                 // monomers per segment
noMonomersSimd:true:1.0;                // rigid static rods (also forced in code)
// --- single minifilament, turnover OFF ---
myoMiniLifetime:true:1.0E9;             // turnover effectively off
numMyoDimersEachEndOfMiniFil:true:8.0;
// minifilament/motor thermal: small, nonzero (wiggle to engage, but no twirling)
BTransCoeff:true:1.0;
BRotCoeff:true:0.3;
// --- myosin binding active so the minifilament engages the actin ---
myosinStallForce:true:2.0;
myosinReleaseRate:true:10.0;
myoFBRBase:true:0.1;
myoFBRExp:true:0.4;
// --- suppress all other populations / nucleation ---
bugOff:true:1.0;
simOutsideBug:false:0.0;
initialFilaments:false:0.0;
initialMyoMiniFils:false:0.0;
equilNodes:false:0.0;
kRdmNuc:false:0.0;
kNodeNuc:false:0.0;
// --- actin turnover off (static field) ---
kATPOn1:false:0.0;
kATPOff1:false:0.0;
kADPOff1:false:0.0;
kATPOn2:false:0.0;
kATPOff2:false:0.0;
kADPOff2:false:0.0;
capRate:false:0.0;
cofilinRate:false:0.0;
cofilinConc:false:0.0;
kHydrolysis:false:0.0;
kDissociation:false:0.0;
