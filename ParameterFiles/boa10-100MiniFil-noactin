kATPOn2NonHydroWithFormin:true:0.0;     // ATP Actin On Rate - No-hydro/node attached
kATPOff2NonHydroWithFormin:true:0.0;    // ATP Actin Off Rate - No-hydro/node attached
capRate:true:3.0;                       // Cap rate by cap protein
cofilinRate:true:0.4;                   // Cofilin Binding Rate (severing driver — kept ON)
cofilinConc:true:3.0;                   // Cofilin Concentration
