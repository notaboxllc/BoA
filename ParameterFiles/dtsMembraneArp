<BOA> DTS membrane v2 -- ARP DIFFUSION DEMO: activated Arp2/3 is produced at NPF "hot" patches and diffuses
<BOA> across the membrane over the wing-edge graph (reaction-diffusion), forming a halo around each patch and
<BOA> settling to steady state. No actin yet -- this establishes the per-vertex surface-chemistry field + the
<BOA> edge-graph diffusion that branched nucleation will read. View the heat-map with the "DTS Arp heatmap"
<BOA> toggle. The membrane is a static sphere (bending only).

buildDtsMembrane:true:1.0;
dtsMembraneSubdiv:true:4;          // nu=4 -> 2562 vertices (smooth heat-map)
dtsMembraneRadius:true:1.2;
dtsVertexRadiusFrac:true:0.5;

// --- hold a clean static sphere (bending only) ---
dtsKappaBend:true:1.0e-19;
dtsKappaArea:true:0.0;
dtsKappaVolume:true:0.0;
dtsBrownianOff:true:1.0;

// --- activated Arp2/3 reaction-diffusion field ---
dtsArpOn:true:1.0;
dtsArpHotPatches:true:5;
dtsArpHotPatchDeg:true:12.0;
dtsArpTarget:true:1.0;
dtsArpDiffusion:true:0.1;          // per-step graph diffusion (alpha*valence < 1 for stability)
dtsArpDecay:true:0.015;            // halo length ~ sqrt(0.1/0.015) ~ 2.6 edges -> distinct patches+halos

deltaT:true:1.0E-5;
collisionDeltaT:true:1.0E-5;
brownianDeltaT:true:1.0E-5;
biochemDeltaT:true:0.001;
runTime:true:0.05;
toFileInterval:true:120.0;
remoteWriteInterval:true:2000.0;

boxXDim:true:5.0;
boxYDim:true:5.0;
boxZDim:true:5.0;
aeta:true:0.1;

// --- actin / motors / bugs / legacy membrane OFF ---
simOutsideBug:false:0.0;
initialFilaments:false:0.0;
initialMyoMiniFils:false:0.0;
equilNodes:false:0.0;
fillNodeCt:true:0;
buildBranchedFils:false:0.0;
buildMembraneSheet:false:0.0;
buildMembraneSphere:false:0.0;
forminConc:true:0.0;
ratchetOn:false:0.0;
