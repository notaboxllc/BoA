<BOA> NODE COALESCENCE ASSAY — two formin-bearing protein nodes 1 micron apart, each holding 60
// myosins. Each node's formin holds the barbed/plus end of ONE pre-built long actin mother whose
// pointed end is aimed across the gap at the partner node (the two mothers are antiparallel and
// overlap in the middle). The surface myosins engage the partner filament and power-stroke toward its
// barbed end (at the partner node), dragging the two nodes together = the nodes COALESCE. RUN ON CPU.
// Driven by the twoNodeFormin* flags (Env.java) -> ProteinNode.makeForminNodePair(). See JOURNAL.md.
//   java -Xmx800M -cp ".:libs/*" BoxOfActin -r -pf ParameterFiles/nodeCoalescenceAssay -3js <dir>
// --- time stepping (small dt for stability) ---
deltaT:true:1.0E-5;                     // Time Step
biochemDeltaT:true:0.01;                // Time Step For Biochemical Events
collisionDeltaT:true:1.0E-5;            // Time Step For Collision Detection
runTime:true:1.0;                       // 100k steps @ 1e-5
toFileInterval:true:500.0;             // ~200 frames
remoteWriteInterval:true:5000.0;
// --- bending regime (filaments stay reasonably straight) ---
fracMove:true:0.0573;
fracR:true:1.0;
fracMoveTorq:true:0.01;
aeta:true:0.1;                          // viscosity (Pa·s)
// --- box: room for the 1 um gap plus the antiparallel mothers along X ---
boxXDim:true:4.0;
boxYDim:true:1.0;
boxZDim:true:1.0;
bugShapedCrucible:false:0.0;            // plain Chamber box (not pill)
simOutsideBug:false:0.0;                // no Listeria
// --- the node coalescence assay (twoNodeFormin flags) ---
twoNodeFormin:true:1.0;                 // place the two facing formin nodes + pre-built mothers
twoNodeForminSep:true:1.0;              // 1 micron apart (nodes at x = +/-0.5)
twoNodeForminFilSegs:true:9.0;          // 9 segments x 64 mono ~ 1.6 um mother (good overlap)
numNodeMyos:true:60.0;                  // 60 surface myosins on each node
numNodeMyoDimers:true:0.0;             // singlets, not dimers
nodeRadius:true:0.025;
forminsPerNode:true:1.0;                // one formin (mother) per node (bookkeeping)
// --- the mothers are PRE-BUILT and static: no stochastic nucleation, no turnover ---
kNodeNuc:false:0.0;                      // do NOT nucleate extra filaments
kRdmNuc:false:0.0;
filSegLength:true:64.0;                 // monomers per segment
noMonomersSimd:true:1.0;                // rigid static rods (proven CPU contractility path)
forminBarbedBrownianFactor:true:0.05;   // 1/20 thermal on the formin-held mothers
nodeTorqSpring:true:1.0E-18;            // torsional spring holds each mother aimed at the partner
// --- myosin binding active so the surface myosins engage the partner filament ---
myosinStallForce:true:2.0;
// --- myosin/motor thermal: small, nonzero (wiggle to engage, no twirling) ---
BTransCoeff:true:1.0;
BRotCoeff:true:0.3;
// --- actin turnover OFF (static-length mothers) ---
kATPOn1:false:0.0;
kATPOff1:false:0.0;
kADPOff1:false:0.0;
kATPOn2:false:0.0;
kATPOff2:false:0.0;
kADPOff2:false:0.0;
capRate:false:0.0;
cofilinRate:false:0.0;
cofilinConc:false:0.0;
kHydrolysis:false:0.0;
kDissociation:false:0.0;
// --- suppress all other populations ---
initialFilaments:false:0.0;
initialMyoMiniFils:false:0.0;
fixedMyosinClusters:false:0.0;
