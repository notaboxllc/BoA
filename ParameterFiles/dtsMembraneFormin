<BOA> DTS membrane v2 -- FORMIN NUCLEATION DEMO: NPF "hot" patches carry a depletable formin pool and
<BOA> nucleate LINEAR mother actin filaments just inside the cortex, anchored to the membrane (ERM-like end1
<BOA> tether). This turns real actin ON. The Arp2/3 heat-map shows the patches; short actin seeds sprout
<BOA> inward from them. (Arp branching off the mothers + membrane push are later steps.)

buildDtsMembrane:true:1.0;
dtsMembraneSubdiv:true:4;          // nu=4 -> 2562 vertices
dtsMembraneRadius:true:1.2;
dtsVertexRadiusFrac:true:0.5;

// --- hold a clean static sphere (bending only) ---
dtsKappaBend:true:1.0e-19;
dtsKappaArea:true:0.0;
dtsKappaVolume:true:0.0;
dtsBrownianOff:true:1.0;

// --- Arp2/3 field (provides the hot patches + heat-map) ---
dtsArpOn:true:1.0;
dtsArpHotPatches:true:5;
dtsArpHotPatchDeg:true:12.0;
dtsArpTarget:true:1.0;
dtsArpDiffusion:true:0.1;
dtsArpDecay:true:0.015;

// --- formin nucleation of mother filaments ---
dtsForminOn:true:1.0;
dtsForminPool:true:1.0;            // 1 mother per hot vertex (no recovery -> bounded)
dtsForminConsume:true:1.0;
dtsForminNucRate:true:8.0;         // mothers/s at a full-pool vertex
dtsForminRecover:true:0.0;

deltaT:true:1.0E-5;
collisionDeltaT:true:1.0E-5;
brownianDeltaT:true:1.0E-5;
biochemDeltaT:true:0.001;
runTime:true:0.05;
toFileInterval:true:120.0;
remoteWriteInterval:true:2000.0;

boxXDim:true:5.0;
boxYDim:true:5.0;
boxZDim:true:5.0;
aeta:true:0.1;

// --- no OTHER actin: no initial filaments, no de-novo/branch nucleation, no free monomer pool (mothers stay short) ---
simOutsideBug:false:0.0;
initialFilaments:false:0.0;
initialMyoMiniFils:false:0.0;
equilNodes:false:0.0;
fillNodeCt:true:0;
buildBranchedFils:false:0.0;
buildMembraneSheet:false:0.0;
buildMembraneSphere:false:0.0;
forminConc:true:0.0;
arpConc:true:0.0;
ratchetOn:false:0.0;
actinSeed:true:40;
