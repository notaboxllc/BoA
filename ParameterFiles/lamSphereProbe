<BOA> ISOLATION TEST: vesicle membrane sphere with NO actin machinery. A single plain protein node
<BOA> (no myosins/formins/Arp) is driven outward (+x) with a constant force into the membrane, to measure
<BOA> how the shell deforms and at what bulge it stalls the probe. Decouples membrane mechanics from actin.

buildMembraneSphere:true:1.0;
membraneCellRadius:true:1.2;
membraneNodeRadius:true:0.05;
membraneCellPackingFactor:true:1.0;
sphereHotPatches:true:0;
deltaT:true:1.0E-5;
collisionDeltaT:true:1.0E-5;
brownianDeltaT:true:1.0E-5;
biochemDeltaT:true:0.001;
runTime:true:0.1;
// #2: raise the membrane node drag to a PHYSICAL value so the membrane lives at the same force scale
// (~1e-11 N) as the probe/actin, instead of the 1e-10-scaled near-zero drag that decoupled it from
// physical collision forces. The spring relaxation is drag-coupled (projection) so its dynamics are
// ~unchanged; the collision force now couples.
membraneNodeDragScale:true:1.0;
toFileInterval:true:100.0;
remoteWriteInterval:true:2000.0;
boxXDim:true:5.0;
boxYDim:true:5.0;
boxZDim:true:5.0;
aeta:true:0.1;

// --- everything that makes actin / motors / bugs OFF ---
simOutsideBug:false:0.0;
initialFilaments:false:0.0;
initialMyoMiniFils:false:0.0;
equilNodes:false:0.0;
fillNodeCt:true:0;
buildBranchedFils:false:0.0;
forminConc:true:0.0;
nucRateNearArpFactors:true:0.0;
branchRateNearArpFactors:true:0.0;
kNodeNuc:true:0.0;
arpLocalField:false:0.0;
ratchetOn:false:0.0;

// --- membrane: Tier-1 stabilizers + vesicle shell + yield (so the relaxation re-applies the probe push) ---
membraneLinkFracMove:true:0.15;
membraneRelaxGpuShaped:true:1.0;
membraneFixedStiffnessDt:true:1e-5;
membraneMaxLinkStrain:true:0.5;
membraneLinkRestFrac:true:1.0;
membraneLinkCenterAttach:true:1.0;
membraneRelaxAvgValence:true:1.0;
membraneNodeMaxDispFrac:true:0.25;
membraneFaceCollideOn:true:1.0;
membraneYield:true:1.0;
membraneVesicle:true:1.0;
membraneVolumeModulus:true:5000.0;
membraneTurgorP0:true:0.0;
membraneAreaGrow:false:0.0;

// --- the constant-force probe ---
membraneProbeForce:true:2.0E-11;
membraneProbeRadius:true:0.25;
membraneProbeStartRadius:true:0.0;
